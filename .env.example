# PhishLens initial foundation has no runtime secrets or external services.
# Future integrations must add placeholders only; never commit real credentials.
PHISHLENS_MAX_EMAIL_BYTES=10485760
PHISHLENS_MAX_ATTACHMENT_BYTES=5242880
# Raw mode treats message-supplied Authentication-Results as untrusted assertions.
PHISHLENS_AUTH_RESULTS_MODE=raw
PHISHLENS_TRUSTED_AUTHSERV_ID=
# Optional Phase 3B.1 provider configuration; blank means disabled.
PHISHLENS_VT_API_KEY=
PHISHLENS_ABUSEIPDB_API_KEY=
PHISHLENS_TI_TIMEOUT_SECONDS=10
